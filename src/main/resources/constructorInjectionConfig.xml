<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:p="http://www.springframework.org/schema/p"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">


    <!--bean for BankAccount class-->
    <bean class="com.example.springDemo.constructorInjection.BankAccount" name="bankAccount">
        <constructor-arg value="Shyam Vachhani"/>
        <constructor-arg value="200000" type="Double"/>
        <constructor-arg ref="transactionMessage"/>
    </bean>

    <bean class="com.example.springDemo.constructorInjection.TransactionMessage" name="transactionMessage"/>
</beans>
