<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:p="http://www.springframework.org/schema/p"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">
<!--    bean for student class-->
    <bean class="com.example.springDemo.SetterInjection.Student" name="student">
        <property name="studentName" value="Shyam" />

        <property name="rollNo">
            <value>11</value>
        </property>
    </bean>

<!--using p-schema-->
    <bean class="com.example.springDemo.SetterInjection.Student" name="student2" p:studentName="ram" p:rollNo="12"/>

    <!--    bean for student class-->
    <bean class="com.example.springDemo.SetterInjection.Collections.Employee" name="employee1">

        <property name="employeeNames">
            <list>
                <value>Shyam</value>
                <value>John</value>
                <value>Ram</value>
            </list>
        </property>

        <property name="employeeIds">
            <set>
                <value>1</value>
                <value>2</value>
                <value>3</value>
            </set>
        </property>
    </bean>
</beans>
